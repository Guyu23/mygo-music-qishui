{
  "id": "qishui",
  "name": "Soda Music",
  "version": "0.1.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "api.qishui.com",
      "www.qishui.com",
      "*.qishui.com",
      "*.douyinpic.com",
      "*.douyinvod.com",
      "*.douyincdn.com",
      "*.byteimg.com",
      "*.ibyteimg.com",
      "*.bytecdn.cn"
    ]
  },
  "requestHeaders": [
    {
      "hosts": ["*.douyinvod.com", "*.douyinpic.com", "*.douyincdn.com", "*.byteimg.com", "*.ibyteimg.com"],
      "headers": {
        "referer": "https://www.qishui.com/",
        "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
      }
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "title": "Listening Modes", "builtin": "stations" },
    { "builtin": "liked" },
    { "title": "History", "page": "history", "icon": "calendar" },
    { "title": "Charts", "page": "charts", "icon": "chart" }
  ]
}
